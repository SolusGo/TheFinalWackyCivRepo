<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Deploy" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Default</Configuration>
    <Name>Cool Wacky Civs 4</Name>
    <Teaser>Lead the Arachnid Empire or the Scorpion Dominion.</Teaser>
    <Description>The Arachnid Empire and the Scorpion Dominion for Civilization V: Brave New World and Community Patch v151.</Description>
    <Authors>SolusGo</Authors>
    <Homepage>https://github.com/SolusGo/TheFinalWackyCivRepo</Homepage>
    <Guid>4e2d7f10-235f-4323-95ec-6bda1a25d27a</Guid>
    <ProjectGuid>{D945A80A-4E05-4479-AD9F-46FBD36F7C21}</ProjectGuid>
    <ModVersion>1</ModVersion>
    <SafeName>Cool Wacky Civs 4</SafeName>
    <AssemblyName>CoolWackyCivs4</AssemblyName>
    <RootNamespace>CoolWackyCivs4</RootNamespace>
    <Stability>Alpha</Stability>
    <AffectsSavedGames>true</AffectsSavedGames>
    <MinCompatibleSaveVersion>0</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>true</SupportsSinglePlayer>
    <SupportsMultiplayer>false</SupportsMultiplayer>
    <SupportsHotSeat>false</SupportsHotSeat>
    <SupportsMac>false</SupportsMac>
    <ReloadAudioSystem>false</ReloadAudioSystem>
    <ReloadLandmarkSystem>false</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>false</ReloadStrategicViewSystem>
    <ReloadUnitSystem>false</ReloadUnitSystem>
    <Civ5UserPath Condition=" '$(Civ5UserPath)' == '' ">$(USERPROFILE)\Documents\My Games\Sid Meier's Civilization 5</Civ5UserPath>
    <ModActions>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>Civilizations/ArachnidEmpire/SQL/ARACHNID_Civilization.sql</FileName>
      </Action>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>Civilizations/ArachnidEmpire/SQL/ARACHNID_Uniques.sql</FileName>
      </Action>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>Civilizations/ArachnidEmpire/XML/ARACHNID_Atlases.xml</FileName>
      </Action>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>Civilizations/ArachnidEmpire/Text/ARACHNID_Text.xml</FileName>
      </Action>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>Civilizations/ScorpionDominion/SQL/SDOM_Civilization.sql</FileName>
      </Action>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>Civilizations/ScorpionDominion/SQL/SDOM_Uniques.sql</FileName>
      </Action>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>Civilizations/ScorpionDominion/XML/SDOM_Atlases.xml</FileName>
      </Action>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>Civilizations/ScorpionDominion/Text/SDOM_Text.xml</FileName>
      </Action>
    </ModActions>
    <ModContent>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Arachnid Empire</Name>
        <Description>Gameplay, save state, and the Arachnid Empire interface.</Description>
        <FileName>Civilizations/ArachnidEmpire/UI/ARACHNID_Console.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Scorpion Dominion</Name>
        <Description>Ascendant gameplay, save state, and the Overlord's War Council.</Description>
        <FileName>Civilizations/ScorpionDominion/UI/SDOM_Council.xml</FileName>
      </Content>
    </ModContent>
    <ModDependencies>
      <Association>
        <Type>Dlc</Type>
        <Name>Expansion - Brave New World</Name>
        <Id>6DA07636-4123-4018-B643-6575B4EC336B</Id>
        <MinVersion>0</MinVersion>
        <MaxVersion>999</MaxVersion>
      </Association>
      <Association>
        <Type>Mod</Type>
        <Name>(1) Community Patch</Name>
        <Id>d1b6328c-ff44-4b0d-aad7-c657f83610cd</Id>
        <MinVersion>151</MinVersion>
        <MaxVersion>151</MaxVersion>
      </Association>
    </ModDependencies>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Default' ">
    <OutputPath>.</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Package Only' ">
    <PackageMod>true</PackageMod>
    <DeployMod>false</DeployMod>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Deploy Only' ">
    <PackageMod>false</PackageMod>
    <DeployMod>true</DeployMod>
  </PropertyGroup>
